# Copy this file to .env and add the API keys you actually have.
# Never commit .env to GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=
NEXORA_PORT=8787

# Instagram Messaging API / Meta webhook
# Keep these values server-side. Never put them in index.html or script.js.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=
